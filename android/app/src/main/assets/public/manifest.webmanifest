  "shortcuts": [
    {
      "name": "Condução (Volante)",
      "short_name": "Condução",
      "description": "Iniciar imediatamente marcha e condução",
      "url": "/?action=set_activity&type=DRIVING",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Outro Trabalho (Carga/Descarga)",
      "short_name": "Trabalho",
      "description": "Comutar para carga, descarga ou atrelagem",
      "url": "/?action=set_activity&type=WORK",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pausa / Descanso Regulamentar",
      "short_name": "Pausa/Repouso",
      "description": "Comutar para descanso ou pausa 15m/45m",
      "url": "/?action=set_activity&type=REST",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Disponibilidade",
      "short_name": "Disponibilidade",
      "description": "Comutar para espera de cais ou 2º condutor",
      "url": "/?action=set_activity&type=AVAILABILITY",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
