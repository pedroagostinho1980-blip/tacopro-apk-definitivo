{
  "id": "/",
  "name": "TacoPro - Gestão de Tempos de Condução e Tacógrafo",
  "short_name": "TacoPro",
  "description": "Aplicação profissional para controlo de tempos de condução, trabalho e descanso de pesados com suporte offline total segundo o Regulamento (CE) n.º 561/2006 e normas nacionais.",
  "lang": "pt",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "portrait",
  "theme_color": "#020617",
  "background_color": "#020617",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
